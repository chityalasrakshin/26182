# ==============================================================================
# VASP Attribution Engine - Environment Configuration Contract (.env.example)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Blockchain Data Adapters & API Keys
# ------------------------------------------------------------------------------
# Primary EVM Provider (Etherscan v2 unified API, Blockscout, or compatible)
BLOCKCHAIN_API_KEY=your_etherscan_api_key_here
BLOCKCHAIN_API_URL=https://api.etherscan.io/v2/api
CHAIN_ID=1

# Tron Provider (TronGrid API - TRC-20 USDT intelligence)
TRONGRID_API_KEY=your_trongrid_api_key_here

# Bitcoin Provider (Blockchair API - optional key; Blockstream fallback requires no key)
BLOCKCHAIR_API_KEY=your_blockchair_api_key_here

# Multi-chain Unified Fallback (Bitquery GraphQL API - dev/free tier)
BITQUERY_API_KEY=your_bitquery_api_key_here

# ------------------------------------------------------------------------------
# 2. Relational Database & Persistence (Cases, Users, Audit Logs, VASP Registry)
# ------------------------------------------------------------------------------
# SQLite (default for zero-setup local run)
DATABASE_URL=sqlite+aiosqlite:///./data/crypto_trace.db
# PostgreSQL (production/team deployment)
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/setu
# Redis Cache & Queue
REDIS_URL=redis://localhost:6379/0

# ------------------------------------------------------------------------------
# 3. Graph Database (Neo4j Community - Phase 1 Graph Ingestion & ShortestPath)
# ------------------------------------------------------------------------------
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_neo4j_password_here

# ------------------------------------------------------------------------------
# 4. LLM Narrative & Report Generation (Phase 5 - Claude API)
# ------------------------------------------------------------------------------
# Claude API Key (strictly for narrative & disclosure request generation)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
CLAUDE_API_KEY=your_anthropic_api_key_here

# ------------------------------------------------------------------------------
# 5. Authentication & Security (Phase 4 - JWT / RBAC)
# ------------------------------------------------------------------------------
JWT_SECRET_KEY=change_this_to_a_secure_random_jwt_secret_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ------------------------------------------------------------------------------
# 6. Graph Traversal & Rate Limiting Bounds
# ------------------------------------------------------------------------------
MAX_HOPS=3
MAX_NODES_PER_ANALYSIS=150
MAX_TRANSACTIONS_PER_ADDRESS=50

REQUEST_TIMEOUT_SECONDS=15
MAX_RETRIES=3
RATE_LIMIT_DELAY_SECONDS=0.25
